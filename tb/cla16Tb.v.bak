
module cla16Tb();

reg [15:0] a;
reg [15:0] b;
reg cin;

wire [15:0] sum;
wire cout;

integer i, j;

// DUT
cla16 dut(
    .a(a),
    .b(b),
    .cin(cin),
    .sum(sum),
    .cout(cout)
);

initial
begin
    cin = 0;

    a = 16'h0000; b = 16'h0000; #10;
    a = 16'h0001; b = 16'h0001; #10;
    a = 16'h000F; b = 16'h0001; #10;
    a = 16'h00FF; b = 16'h0001; #10;
    a = 16'h0FFF; b = 16'h0001; #10;
    a = 16'hFFFF; b = 16'h0001; #10;
    a = 16'hAAAA; b = 16'h5555; #10;
    a = 16'h1234; b = 16'h4321; #10;

    cin = 1;

    a = 16'h0000; b = 16'h0000; #10;
    a = 16'hFFFF; b = 16'h0000; #10;
    a = 16'h7FFF; b = 16'h0001; #10;
    a = 16'h8000; b = 16'h8000; #10;
    a = 16'hABCD; b = 16'h1234; #10;

    $finish;
end

initial
begin
    $monitor("Time=%0t A=%h B=%h Cin=%b Sum=%h Cout=%b",
              $time, a, b, cin, sum, cout);
end

endmodule
